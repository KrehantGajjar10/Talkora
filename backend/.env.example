# ==============================================================================
# Talkora Backend Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your local development environment.
# NEVER commit the actual .env file or real secrets to version control.

# Application Environment ('development' | 'production' | 'test')
# In production, this MUST be explicitly set to 'production'.
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (Single origin or comma-separated list of allowed origins)
# In production: MUST be HTTPS and cannot be localhost or loopback addresses.
# Origins must not contain paths, queries, hashes, or credentials.
FRONTEND_URL=http://localhost:3000

# Reverse Proxy Trust Configuration ('1' | 'true' | 'false' | integer hop count | CIDRs/subnets)
# Configure according to your cloud provider (e.g. Render, Railway, AWS ALB, Cloudflare).
# Multi-instance note: when scaling to multiple instances behind a load balancer,
# ensure client IP resolution remains deterministic.
TRUST_PROXY=1

# PostgreSQL Database Connection Strings (Neon Serverless PostgreSQL)
# Pooled connection string with SSL mode for application queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/talkora?sslmode=require"
# Unpooled direct connection string for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/talkora?sslmode=require"

# JWT Authentication & Session Security
# Generate using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# MUST be at least 32 characters long
ACCESS_TOKEN_SECRET="at-least-32-characters-long-cryptographically-secure-secret-key"

# Cookie Configuration
# SameSite attribute ('lax' | 'strict' | 'none')
# Use 'lax' when frontend and backend share the parent domain (e.g. app.talkora.com and api.talkora.com).
# Use 'none' (with secure cookies) if frontend and backend reside on completely distinct top-level domains.
COOKIE_SAME_SITE=lax
# Optional domain scoping for multi-subdomain deployments (e.g. '.talkora.com'; leave empty for localhost)
COOKIE_DOMAIN=

# Cloudinary Storage Configuration (Optional in development, strictly required in production)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==============================================================================
# Regression Test Suite Safety Configuration (DO NOT RUN AGAINST PRODUCTION)
# ==============================================================================
# The regression test runner will refuse to run unless all safety parameters below are explicitly configured:
# 1. ALLOW_TEST_EXECUTION must be 'true'
# 2. TEST_DATABASE_URL must point to a dedicated, isolated test database branch
# 3. EXPECTED_TEST_DB_HOST must match the exact hostname of the test branch endpoint
# 4. EXPECTED_TEST_DB_NAME must match the database name on the test branch
# 5. PROTECTED_DATABASE_HOSTS comma-separated list of protected production/main hostnames to abort on
ALLOW_TEST_EXECUTION=false
TEST_DATABASE_URL="postgresql://user:password@ep-test-branch-sample.us-east-2.aws.neon.tech/talkora_test?sslmode=require"
EXPECTED_TEST_DB_HOST="ep-test-branch-sample.us-east-2.aws.neon.tech"
EXPECTED_TEST_DB_NAME="talkora_test"
PROTECTED_DATABASE_HOSTS="ep-prod-branch.us-east-2.aws.neon.tech,ep-main.us-east-2.aws.neon.tech"
